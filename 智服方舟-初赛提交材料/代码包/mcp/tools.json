{
  "description": "外部工具集成契约：REST 契约先行，后续迁移 MCP 仅需协议适配层；src/mcp 提供参考实现（tools/list + tools/call）",
  "tools": [
    {
      "name": "ticket.create",
      "entry": "POST /api/v1/tickets",
      "auth": "OAuth2 client-credentials, scope=ticket:write",
      "params": {"ticket_id": "string", "channels": "string[]", "fingerprint": "string", "raw_snippet": "string"},
      "returns": {"created": "boolean", "ticket": "object"},
      "permission": "本部门工单读写",
      "retry": "3次指数退避",
      "idempotency": "ticket_id 唯一",
      "audit": "全量审计",
      "degradation": "故障时降级邮件工单",
      "mcp_name": "ticketing-mcp.ticket_create"
    },
    {
      "name": "ticket.get",
      "entry": "GET /api/v1/tickets/{id}",
      "auth": "OAuth2, scope=ticket:read",
      "params": {"ticket_id": "string"},
      "returns": {"found": "boolean", "ticket": "object"},
      "permission": "只读",
      "retry": "3次",
      "idempotency": "无状态",
      "audit": "查询审计",
      "degradation": "返回缓存",
      "mcp_name": "ticketing-mcp.ticket_get"
    },
    {
      "name": "ticket.find_by_fingerprint",
      "entry": "GET /api/v1/tickets?fingerprint={fp}",
      "auth": "OAuth2, scope=ticket:read",
      "params": {"fingerprint": "string"},
      "returns": {"found": "boolean", "ticket_id": "string"},
      "permission": "只读",
      "retry": "3次",
      "idempotency": "无状态",
      "audit": "查询审计",
      "degradation": "返回缓存",
      "mcp_name": "ticketing-mcp.ticket_find_by_fingerprint"
    },
    {
      "name": "ticket.update",
      "entry": "PATCH /api/v1/tickets/{id}",
      "auth": "OAuth2, scope=ticket:write",
      "params": {"ticket_id": "string", "status": "string", "note": "string"},
      "returns": {"updated": "boolean", "ticket": "object"},
      "permission": "本部门工单读写",
      "retry": "3次",
      "idempotency": "按 ticket_id + status",
      "audit": "全量审计",
      "degradation": "降级人工更新",
      "mcp_name": "ticketing-mcp.ticket_update"
    },
    {
      "name": "refund.create",
      "entry": "POST /api/v1/refunds",
      "auth": "OAuth2 + approval-token",
      "params": {"order_id": "string", "amount": "number", "currency": "string", "idempotency_key": "string", "approval_token": "string"},
      "returns": {"status": "SUCCESS|DUPLICATE|FAILED", "refund": "object"},
      "permission": "退款额度受限额策略约束（单日≤5000）",
      "retry": "3次指数退避",
      "idempotency": "idempotency_key 全局唯一，冲突返回既有结果",
      "audit": "含审批凭证",
      "degradation": "降级转人工退款",
      "mcp_name": "payment-mcp.refund_create"
    },
    {
      "name": "refund.get",
      "entry": "GET /api/v1/refunds/{txn}",
      "auth": "OAuth2, scope=payment:read",
      "params": {"refund_txn_id": "string"},
      "returns": {"found": "boolean", "refund": "object"},
      "permission": "只读",
      "retry": "3次",
      "idempotency": "无状态",
      "audit": "查询审计",
      "degradation": "返回缓存",
      "mcp_name": "payment-mcp.refund_get"
    },
    {
      "name": "refund.rollback",
      "entry": "POST /api/v1/refunds/{txn}/rollback",
      "auth": "OAuth2 + approval-token",
      "params": {"refund_txn_id": "string"},
      "returns": {"status": "ROLLED_BACK", "refund": "object"},
      "permission": "仅限已失败退款",
      "retry": "3次",
      "idempotency": "按 refund_txn_id",
      "audit": "全量审计",
      "degradation": "转人工处理",
      "mcp_name": "payment-mcp.refund_rollback"
    },
    {
      "name": "account.get",
      "entry": "GET /api/v1/accounts/{id}",
      "auth": "OAuth2, scope=crm:read",
      "params": {"customer_id": "string"},
      "returns": {"found": "boolean", "account": "object"},
      "permission": "只读",
      "retry": "2次",
      "idempotency": "无状态",
      "audit": "查询审计",
      "degradation": "返回缓存",
      "mcp_name": "crm-mcp.account_get"
    },
    {
      "name": "account.update",
      "entry": "PATCH /api/v1/accounts/{id}",
      "auth": "OAuth2 + approval-token",
      "params": {"customer_id": "string", "field": "string", "old": "string", "new": "string", "approval_token": "string"},
      "returns": {"updated": "boolean", "account": "object", "audit": "object"},
      "permission": "白名单字段（phone/address/level），敏感字段需审批",
      "retry": "2次",
      "idempotency": "变更前后值对拍",
      "audit": "含变更前后值",
      "degradation": "降级转人工",
      "mcp_name": "crm-mcp.account_update"
    },
    {
      "name": "kb.search",
      "entry": "POST /api/v1/kb/search",
      "auth": "API Key, scope=kb:read",
      "params": {"query": "string", "top_k": "integer"},
      "returns": {"hits": [{"doc_id": "string", "title": "string", "score": "number", "snippet": "string"}]},
      "permission": "只读",
      "retry": "2次",
      "idempotency": "无状态",
      "audit": "查询审计",
      "degradation": "返回缓存结果",
      "mcp_name": "kb-mcp.kb_search"
    },
    {
      "name": "kb.upsert",
      "entry": "POST /api/v1/kb/docs",
      "auth": "API Key + approval-token",
      "params": {"doc_id": "string", "title": "string", "content": "string", "tags": "string[]", "approved_by": "string"},
      "returns": {"updated": "boolean", "doc": "object"},
      "permission": "知识写入需审批凭证",
      "retry": "2次",
      "idempotency": "按 doc_id",
      "audit": "全量审计",
      "degradation": "降级为建议清单",
      "mcp_name": "kb-mcp.kb_upsert"
    },
    {
      "name": "notify.send",
      "entry": "POST /api/v1/notifications",
      "auth": "OAuth2, scope=notify:template",
      "params": {"channel": "string", "template": "string", "params": "object", "message_id": "string"},
      "returns": {"sent": "boolean", "message_id": "string", "status": "string"},
      "permission": "仅模板发送，禁自定义内容",
      "retry": "3次",
      "idempotency": "消息ID去重",
      "audit": "审计",
      "degradation": "降级换渠道",
      "mcp_name": "notify-mcp.notify_send"
    }
  ]
}
